# Extraction workspaces / generated outputs (regenerated by tools/)
/work/
/stock-images/
/tools/bin/
/out/
**/.work/

# Large binaries that get regenerated from the stock ROM
*.img
*.img.xz
*.zip
*.tar.gz

# ...except the prebuilt kernel artifacts, which must be committed
!device/xiaomi/miro-kernel/dtbo.img
!device/xiaomi/miro-kernel/prebuilt_kernel_headers.tar.gz

# Keep the checked-in file lists and makefiles
!device/xiaomi/**/modules.load
!device/xiaomi/**/modules.blocklist

# Python bytecode
__pycache__/
*.pyc

# Generated vendor blobs (never commit to the kit; they go to the vendor repos)
/vendor/xiaomi/miro/system/
/vendor/xiaomi/miro/system_ext/
/vendor/xiaomi/miro/product/
/vendor/xiaomi/miro/vendor/
/vendor/xiaomi/miro/odm/
/vendor/xiaomi/miro/mi_ext/
/vendor/xiaomi/sm8750-common/system/
/vendor/xiaomi/sm8750-common/system_ext/
/vendor/xiaomi/sm8750-common/product/
/vendor/xiaomi/sm8750-common/vendor/
/vendor/xiaomi/sm8750-common/odm/
/vendor/xiaomi/sm8750-common/mi_ext/
