<?xml version="1.0" encoding="UTF-8"?>
<!--
  Evolution X (cnb / Android 17) local manifest for POCO F7 Ultra (miro).

  Usage (from the root of your Evolution X source tree):

      mkdir -p .repo/local_manifests
      cp manifest/miro.xml .repo/local_manifests/miro.xml
      repo sync -c -j8    # full flag set in docs/build-cnb.md §1

  The miro trees are hosted under github.com/sulthonuladib
  (android_device_xiaomi_miro, android_device_xiaomi_miro-kernel,
   proprietary_vendor_xiaomi_miro, proprietary_vendor_xiaomi_sm8750-common).

  NOTE: the Qualcomm CAF HALs for sm8750 (audio/*, display/*) are provided by
  the base Evolution X cnb manifest via snippets/lineage.xml. Three QTI/LineageOS
  trees that carry miro build fixes are forked to sulthonuladib and overridden
  below: hardware/qcom-caf/common, hardware/qcom-caf/sm8750/dataipa and
  device/qcom/sepolicy_vndr/sm8750.
-->
<manifest>

  <!-- Upstream A17 SM8750 Xiaomi common tree now forked to sulthonuladib so
       the miro OS3 vendor-list fixes and boot-jar ordering can be carried.
       See HANDOFF.md and the `cnb` branch of the fork. -->
  <remote name="crisplos" fetch="https://github.com/Crisp-los" revision="cnb" />

  <!-- Trees hosted by you. -->
  <remote name="miro" fetch="https://github.com/sulthonuladib" revision="cnb" />

  <!-- Upstream hardware interfaces. -->
  <remote name="los" fetch="https://github.com/LineageOS" revision="lineage-24.0" />

  <!-- Platform: forked Crisp-los tree with the miro fixes. -->
  <project path="device/xiaomi/sm8750-common" name="android_device_xiaomi_sm8750-common" remote="miro" />

  <!-- Device -->
  <project path="device/xiaomi/miro"        name="android_device_xiaomi_miro"        remote="miro" />
  <project path="device/xiaomi/miro-kernel" name="android_device_xiaomi_miro-kernel" remote="miro" />

  <!-- Vendor trees (generate with tools/, then push). -->
  <project path="vendor/xiaomi/miro"          name="proprietary_vendor_xiaomi_miro"          remote="miro" />
  <project path="vendor/xiaomi/sm8750-common" name="proprietary_vendor_xiaomi_sm8750-common" remote="miro" />

  <!-- hardware/xiaomi is NOT in the Evolution X cnb manifest; add it. -->
  <project path="hardware/xiaomi" name="android_hardware_xiaomi" remote="los" />

  <!-- QTI/LineageOS trees with miro build fixes, forked to sulthonuladib.
       remove-project drops the base-manifest copy (the sepolicy name covers all
       sm* paths; only sm8750 is re-added, which is all miro needs). -->
  <remove-project name="LineageOS/android_hardware_qcom-caf_common" />
  <project path="hardware/qcom-caf/common"
           name="android_hardware_qcom-caf_common"
           remote="miro" revision="lineage-24.0" />

  <remove-project name="LineageOS/android_vendor_qcom_opensource_dataipa" />
  <project path="hardware/qcom-caf/sm8750/dataipa"
           name="android_vendor_qcom_opensource_dataipa"
           remote="miro" revision="lineage-24.0-caf-sm8750" />

  <remove-project name="LineageOS/android_device_qcom_sepolicy_vndr" />
  <project path="device/qcom/sepolicy_vndr/sm8750"
           name="android_device_qcom_sepolicy_vndr"
           remote="miro" revision="lineage-24.0-caf-sm8750" />

</manifest>
